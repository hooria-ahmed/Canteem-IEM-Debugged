# Database (MySQL is the normal application database)
CANTEEN_DB_NAME=canteen_connection
CANTEEN_DB_USER=root
CANTEEN_DB_PASSWORD=change-me
CANTEEN_DB_HOST=localhost
CANTEEN_DB_PORT=3306

# Django application security
CANTEEN_SECRET_KEY=replace-with-a-long-random-secret
CANTEEN_DEBUG=1
CANTEEN_ALLOWED_HOSTS=127.0.0.1,localhost
CANTEEN_SECURE_COOKIES=0
CANTEEN_SECURE_SSL_REDIRECT=0
CANTEEN_HSTS_SECONDS=0
CANTEEN_HSTS_INCLUDE_SUBDOMAINS=0
CANTEEN_HSTS_PRELOAD=0

# Only enable intentionally when you want demo procurement data.
CANTEEN_ALLOW_DEMO_SEED=0

# Optional local validation database; normal app use leaves this unset/0.
CANTEEN_USE_SQLITE=0
